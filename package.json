{
  "name": "fifa-manager-online",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fmo/web",
    "pack:fetch": "npm run pack:fetch -w @fmo/data --",
    "pack:build": "npm run pack:build -w @fmo/data",
    "cap": "npm run cap -w @fmo/web --",
    "mobile:sync": "npm run mobile:sync -w @fmo/web",
    "calibrate": "npm run calibrate -w @fmo/engine --",
    "play": "npm run play -w @fmo/engine --",
    "benchmark": "npm run benchmark -w @fmo/engine --",
    "tune": "npm run tune -w @fmo/engine --",
    "tune:clubs": "npm run tune:clubs -w @fmo/engine --",
    "career": "npm run career -w @fmo/career --",
    "manager": "npm run manager -w @fmo/career --",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
